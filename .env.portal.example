# ============================================================================
# CLIENT PORTAL — ENVIRONMENT VARIABLES
# Copy this to .env.local (dev) and set the same in your Vercel project
# settings (Production + Preview) for deployment. Never commit real values.
# ============================================================================

# --- Supabase --------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: SECRET. Server-only. Never expose to the browser/client
# bundle. Used only in webhook + admin routes (see lib/portal/supabase.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Razorpay ----------------------------------------------------------------
# Dashboard -> Settings -> API Keys (use test keys first, switch to live once
# verified end-to-end)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
# Dashboard -> Settings -> Webhooks -> create a webhook pointing to
# https://yourdomain.com/api/portal/payments/webhook, subscribe to:
#   payment.captured, payment.failed, refund.processed, refund.failed
# then copy the "Webhook Secret" shown there (NOT the same as KEY_SECRET).
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# --- Translation (Google Cloud Translation API v2) --------------------------
# console.cloud.google.com -> enable "Cloud Translation API" -> Credentials
# -> Create API Key -> restrict it to the Cloud Translation API only.
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key

# --- Rate limiting (Upstash Redis) -------------------------------------
# Needed for rate limits to work correctly across multiple server instances
# (e.g. on Vercel). Without these, login/register/2FA rate limiting falls
# back to in-memory, which only protects a single instance.
# console.upstash.com -> Create Database (Redis, "Regional", free tier is
# fine) -> REST API section has both values below.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# --- App ----------------------------------------------------------------
NODE_ENV=production
